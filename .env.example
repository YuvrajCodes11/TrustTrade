# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# Database & Cache Connection Strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trusttrade?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="trusttrade-super-secret-access-token-key-32bytes-min"
JWT_REFRESH_SECRET="trusttrade-super-secret-refresh-token-key-32bytes-min"

# SMS Provider Credentials (Twilio or MSG91)
SMS_PROVIDER="mock" # "mock", "twilio", or "msg91"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# KYC Vendor Credentials (IDfy, HyperVerge, or Signzy)
KYC_VENDOR="mock" # "mock", "idfy", "hyperverge", or "signzy"
KYC_API_KEY=""
KYC_CLIENT_ID=""

# S3 / Cloudflare R2 Object Storage
S3_REGION="ap-south-1"
S3_BUCKET="trusttrade-uploads"
S3_ENDPOINT="" # Optional custom endpoint for Cloudflare R2
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
